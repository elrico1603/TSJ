# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Cloud Storage Configuration (Server-Side Evidence Vault)
# Optional explicit overrides; defaults to Application Default Credentials (ADC)
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_CLOUD_STORAGE_BUCKET="timbersmith-evidence-vault"
GOOGLE_CLOUD_REGION="africa-south1"

# Registered production Clocking candidate. Keep OFF until isolated acceptance,
# published default + named-registry rules, IAM and backup/restore are verified.
VITE_ENABLE_PRODUCTION_CLOCKING=false
# Public device identifier for the first approved kiosk; never a token or PIN.
VITE_CLOCK_DEVICE_ID=""
# Exact verified HTTPS backend origin, without trailing slash; blank = same-origin.
# When blank, configure a reviewed Netlify proxy before its SPA fallback.
VITE_CLOCK_API_ORIGIN=""
# Server runtime gates (not VITE variables). Both are required; defaults are OFF.
TSJ_ENABLE_PRODUCTION_CLOCKING=false
TSJ_CLOCK_PRODUCTION_SECURITY_CONFIRMED=""

# Secure management migration candidate. Do not enable against live data until
# reviewed seeding, identity bindings, sanitized projections and default rules cutover are approved.
VITE_ENABLE_SECURE_MANAGEMENT=false
VITE_MANAGEMENT_API_ORIGIN=""
VITE_APP_ID_PATH="timbersmith-terminal-v1"
TSJ_ENABLE_SECURE_MANAGEMENT=false
TSJ_MANAGEMENT_NAMESPACE="timbersmith-terminal-v1"
TSJ_MANAGEMENT_CUTOVER_CONFIRMED=""
